{
  "name": "@synonymdev/mayfly-browser",
  "version": "0.1.0",
  "private": true,
  "description": "The Mayfly browser client: sign-in, the act() loop, decisions, live updates, the home index and the read-only chain reader, over the Mayfly wasm module and the Pubky SDK. Bring your own rules and screens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubky/mayfly.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@synonymdev/mayfly": "file:../../crates/wasm",
    "@synonymdev/pubky": "file:../../../pubky-sdk/bindings/js/pkg",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
